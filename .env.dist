DATABASE_URL=sqlite:///./registry.db

# ── Authentication ────────────────────────────────────────────────────────────
# See docs/oci/authentication.md for the full reference.

# HMAC secret used to sign JWTs.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
WAREHOUSE_AUTH_SECRET_KEY=changeme-please-use-a-strong-random-value

# Token lifetime in seconds (default: 5 minutes)
WAREHOUSE_AUTH_TOKEN_EXPIRATION=300

# Token endpoint URL advertised in WWW-Authenticate challenges.
# Must be reachable by Docker clients.
WAREHOUSE_AUTH_REALM=http://localhost:5000/auth/token

# Service name embedded in the token audience claim.
WAREHOUSE_AUTH_SERVICE=registry

# Internal token issuer label (informational only).
WAREHOUSE_AUTH_ISSUER=registry-token-service

# ── OCI Registry ──────────────────────────────────────────────────────────────

# Storage backend: memory (default) or file.
WAREHOUSE_OCI_REGISTRY_STORAGE_BACKEND=memory

# Directory used by the file storage backend.
WAREHOUSE_OCI_REGISTRY_STORAGE_DIR=data

# Comma-separated username:password pairs loaded on startup.
# Example: WAREHOUSE_OCI_REGISTRY_USERS=alice:supersecret,bob:hunter2
WAREHOUSE_OCI_REGISTRY_USERS=
